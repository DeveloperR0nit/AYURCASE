# Copy this file to .env for local development. Never commit the real .env file.
GEMINI_API_KEY=replace-with-your-server-side-gemini-api-key

# Optional. This is the stable default used when the variable is omitted.
GEMINI_MODEL=gemini-2.5-flash

# Optional. Set this to a mounted persistent disk when deploying with SQLite.
# AYURCASE_DB_PATH=/var/data/ayurcase.db
