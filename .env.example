# Copy this file to .env for local development. Never commit the real .env file.
GEMINI_API_KEY=replace-with-your-server-side-gemini-api-key

# Optional. This is the stable default used when the variable is omitted.
GEMINI_MODEL=gemini-2.5-flash

# Optional. Set this to a mounted persistent disk when deploying with SQLite.
# AYURCASE_DB_PATH=/var/data/ayurcase.db

# Optional: Real SMTP Email Delivery (for patient welcome emails & notifications)
# If omitted or left blank, emails are automatically logged to SQLite email_logs and server console.
# For Gmail, use an App Password generated at: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-hospital-email@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# SMTP_FROM_EMAIL=no-reply@ayurcase.gov.in
# SMTP_FROM_NAME="AYURCASE Digital Health Portal"
# SMTP_USE_TLS=true
# PATIENT_LOGIN_URL=https://ayurcase-u601.onrender.com/login-patient.html
